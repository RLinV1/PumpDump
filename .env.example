# Copy to .env (gitignored): cp .env.example .env
# Infra defaults work as-is with docker-compose.yml. Credentials stay empty until you add your own.

# --- Infrastructure ---
KAFKA_BOOTSTRAP=localhost:9092
POSTGRES_URL=jdbc:postgresql://localhost:5432/pumpwatch
POSTGRES_USER=pumpwatch
POSTGRES_PASSWORD=pumpwatch
TOPIC_PARTITIONS=6

# --- Watchlist (comma-separated tickers; keep within your Alpaca plan's symbol limit) ---
WATCHLIST=GME,AMC,SNDL

# --- Alpaca market data and news (free plan: https://alpaca.markets) ---
ALPACA_ENABLED=false
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# iex on the free plan; sip needs a paid plan
ALPACA_FEED=iex
# symbol limit of your plan for the live stream
ALPACA_SYMBOL_LIMIT=30

# --- Bluesky Jetstream (public firehose, no account needed) ---
BLUESKY_ENABLED=false
BLUESKY_JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe

# --- Reddit (optional; needs an approved Data API app) ---
REDDIT_ENABLED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_SUBREDDITS=pennystocks,smallstreetbets,wallstreetbets

# --- SEC EDGAR (free; a descriptive name and contact email are required) ---
SEC_ENABLED=false
SEC_USER_AGENT=

# --- Finnhub (optional, free tier) ---
FINNHUB_ENABLED=false
FINNHUB_TOKEN=

# --- API (read-only; 127.0.0.1:8083) ---
API_PORT=8083
# comma-separated browser origins allowed to call the API
API_ALLOWED_ORIGINS=http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=120
