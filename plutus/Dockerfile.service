# Pumpwatch lookup and paper-trading service: only api/service.py, no frontend, no broker, no model, no key.
# Build context is this directory (plutus/). Python 3.13 because pyproject requires it.
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app/src:/app USE_MOCK_DATA=1 PLUTUS_DATA_DIR=/data

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Dependencies first so source edits keep this layer.
COPY pyproject.toml ./
RUN python -c "import tomllib;print('\n'.join(tomllib.load(open('pyproject.toml','rb'))['project']['dependencies']))" > /tmp/req.txt \
    && pip install -r /tmp/req.txt

COPY src ./src
COPY api ./api
# /data is the named volume holding the paper-trading SQLite file and the price cache.
RUN useradd --system --home /app plutus && mkdir /data && chown plutus /data
USER plutus
VOLUME /data

EXPOSE 8090
HEALTHCHECK --interval=10s --timeout=5s --retries=10 --start-period=20s \
    CMD curl -fsS http://127.0.0.1:8090/healthz >/dev/null || exit 1
CMD ["uvicorn", "api.service:app", "--host", "0.0.0.0", "--port", "8090"]
