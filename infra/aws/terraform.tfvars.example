# cp terraform.tfvars.example terraform.tfvars   (gitignored). No secrets belong in this file.
region = "us-east-1"

# Narrow to your own address for a private test, e.g. ["203.0.113.7/32"].
allowed_cidrs = ["0.0.0.0/0"]

# Alarm and budget emails (AWS sends a confirmation mail for the SNS subscription).
alarm_email  = ""
budget_email = ""
budget_usd   = 25

# Largest cost line. false = one Kafka task whose data is lost on restart.
enable_msk = false

# HTTPS: set both. Empty serves plain HTTP on the load balancer name.
domain_name     = ""
route53_zone_id = ""

# mock is the public default. live is for load tests only and still uses no Alpaca keys.
data_mode = "mock"

# Raise before a capacity load test, e.g. 100000.
api_rate_limit_per_minute = 120

enable_plutus      = false
enable_github_oidc = false
