# Pumpwatch private service: stock lookup and the flag assistant (api/service.py).
# Build context is this directory (research/). Python 3.13 because pyproject requires it.
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app/src:/app USE_MOCK_DATA=1 RESEARCH_DATA_DIR=/data \
    HOME=/app RAG_DIR=/app/rag-store ANONYMIZED_TELEMETRY=False

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Dependencies first so source edits keep this layer.
COPY pyproject.toml ./
RUN python -c "import tomllib;print('\n'.join(tomllib.load(open('pyproject.toml','rb'))['project']['dependencies']))" > /tmp/req.txt \
    && pip install -r /tmp/req.txt

COPY src ./src
COPY api ./api
COPY evals ./evals
# /data holds the price cache.
RUN useradd --system --home /app research && mkdir /data /app/.cache /app/rag-store && chown -R research /data /app/.cache /app/rag-store
USER research
# Build the knowledge library now: this downloads Chroma's ONNX embedding model once (no key) and embeds the seed files,
# so the container starts fast and works offline. The store lives in the image, not the volume.
# The downloaded archive is not needed once extracted (checked: queries still work with no network).
RUN python -m portfolio_risk.rag.ingest && rm -f /app/.cache/chroma/onnx_models/all-MiniLM-L6-v2/onnx.tar.gz
VOLUME /data

EXPOSE 8090
HEALTHCHECK --interval=10s --timeout=5s --retries=10 --start-period=20s \
    CMD curl -fsS http://127.0.0.1:8090/healthz >/dev/null || exit 1
CMD ["uvicorn", "api.service:app", "--host", "0.0.0.0", "--port", "8090"]
